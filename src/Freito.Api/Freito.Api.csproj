<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Freito.Domain\Freito.Domain.csproj" />
    <ProjectReference Include="..\Freito.Infrastructure\Freito.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Single-domain deploy (technical-plan.md §1): build the React app and copy
    its output into wwwroot so `dotnet publish` produces one artifact that
    serves both the API (/api/*) and the SPA. Runs before Publish, not on
    every `dotnet build`, so a plain build/test loop doesn't need Node.
  -->
  <PropertyGroup>
    <WebAppDir>$(MSBuildThisFileDirectory)..\..\web\</WebAppDir>
    <WebAppDistDir>$(WebAppDir)dist\</WebAppDistDir>
  </PropertyGroup>

  <Target Name="BuildWebApp" BeforeTargets="Publish">
    <Message Importance="high" Text="Building React app in $(WebAppDir)..." />
    <Exec Command="npm install" WorkingDirectory="$(WebAppDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(WebAppDir)" />
    <ItemGroup>
      <WebAppDistFiles Include="$(WebAppDistDir)**" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAppDistFiles)" DestinationFolder="$(MSBuildThisFileDirectory)wwwroot\%(RecursiveDir)" />
  </Target>

</Project>
